    {
      "parameters": {
        "promptType": "define",
        "text": "=Analyze the email security posture using this DNS data:\n{{ JSON.stringify($json.report ?? $json) }}\n\nReturn exactly one JSON object matching the connected schema.\nInclude exactly two results: vulnweb.com and example.com.\nFor each domain provide domain, grade, severity, spf_policy, dmarc_policy, and reason.\nUse grades A-F and severities LOW, MEDIUM, HIGH.\nUse HIGH severity for grade D, E, or F.\nMissing DMARC enforcement must receive a poor grade.\nDo not return Markdown or explanatory text outside the JSON object.\n",
        "hasOutputParser": true,
