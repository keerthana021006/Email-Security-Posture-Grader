    {
      "parameters": {
        "jsCode": "const data = $input.first()?.json ?? {};\nconst results = data.output?.results ?? data.results ?? [];\n\nconst validGrades = [\"A\", \"B\", \"C\", \"D\", \"E\", \"F\"];\nconst validSeverities = [\"LOW\", \"MEDIUM\", \"HIGH\"];\n\nconst validationPassed =\n  Array.isArray(results) &&\n  results.length === 2 &&\n  results.every(r =>\n    typeof r.domain === \"string\" &&\n    validGrades.includes(r.grade) &&\n    validSeverities.includes(r.severity) &&\n    typeof r.spf_policy === \"string\" &&\n    typeof r.dmarc_policy === \"string\" &&\n    typeof r.reason === \"string\" &&\n    r.reason.length <= 300\n  );\n\nconst telegramText = validationPassed\n  ? \"🟣 NGP-024 | exec #\" + $execution.id +\n    \"\\nEmail Security Posture Grader\\n\\n\" +\n    results.map(r =>\n      \"Domain: \" + r.domain +\n      \"\\nGrade: \" + r.grade +\n      \"\\nSeverity: \" + r.severity +\n      \"\\nTag: \" +\n      (r.severity === \"HIGH\" ||\n       [\"D\", \"E\", \"F\"].includes(r.grade)\n        ? \"HIGH\" : \"NORMAL\") +\n      \"\\nSPF: \" + r.spf_policy +\n      \"\\nDMARC: \" + r.dmarc_policy +\n      \"\\nReason: \" + r.reason\n    ).join(\"\\n\\n\")\n  : \"Fallback: AI Agent output is invalid. Please review the email security posture manually.\";\n\nreturn [{\n  json: {\n    results,\n    validation_passed: validationPassed,\n    validation_message: validationPassed\n      ? \"Output validation passed\"\n      : \"Output validation failed\",\n    telegram_text: telegramText\n  }\n}];"
      },
