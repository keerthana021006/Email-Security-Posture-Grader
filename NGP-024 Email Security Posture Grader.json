    {
      "parameters": {
        "jsCode": "const items = $input.all().map(item => item.json);\n\nconst domains = [\"vulnweb.com\", \"example.com\"];\n\nconst report = domains.map(domain => {\n  const rootRecord = items.find(item =>\n    item.Question?.[0]?.name?.replace(/\\.$/, \"\") === domain\n  );\n\n  const dmarcRecord = items.find(item =>\n    item.Question?.[0]?.name?.replace(/\\.$/, \"\") ===\n    \"_dmarc.\" + domain\n  );\n\n  const spf = (rootRecord?.Answer ?? [])\n    .map(record => record.data ?? \"\")\n    .find(value => value.startsWith(\"v=spf1\")) ?? \"Missing\";\n\n  const dmarc = (dmarcRecord?.Answer ?? [])\n    .map(record => record.data ?? \"\")\n    .find(value => value.startsWith(\"v=DMARC1\"));\n\n  let dmarcPolicy = \"Missing\";\n\n  if (dmarc) {\n    const match = dmarc.match(/(?:^|;)\\s*p\\s*=\\s*(none|quarantine|reject)/i);\n    if (match) {\n      dmarcPolicy = match[1].toLowerCase();\n    } else {\n      dmarcPolicy = \"Invalid or unspecified\";\n    }\n  }\n\n  return {\n    domain,\n    spf_policy: spf,\n    dmarc_policy: dmarcPolicy\n  };\n});\n\nconst validationPassed = report.every(item =>\n  item.spf_policy !== \"Missing\"\n);\n\nreturn [{\n  json: {\n    report,\n    validation_passed: validationPassed,\n    validation_message: validationPassed\n      ? \"DNS data prepared successfully\"\n      : \"SPF record missing for one or more domains\"\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        224
      ],
